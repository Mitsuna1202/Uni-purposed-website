    <!-- https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#favoriteSportOf -->

    <owl:ObjectProperty rdf:about="https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#favoriteSportOf">
        <owl:inverseOf rdf:resource="https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#favoriteSportOf"/>
        <rdfs:domain rdf:resource="https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#FavoriteSport"/>
        <rdfs:range rdf:resource="https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#Person"/>
        <rdfs:comment>A sport is the favorite of a person</rdfs:comment>
        <rdfs:label>favorite sport of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#hasFavoriteSport -->

    <owl:ObjectProperty rdf:about="https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#hasFavoriteSport">
        <rdfs:domain rdf:resource="https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#Person"/>
        <rdfs:range rdf:resource="https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#FavoriteSport"/>
        <rdfs:comment>A lecturer or a student have a favorite sport</rdfs:comment>
        <rdfs:label>has favorite sport</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#FavoriteSport -->

    <owl:Class rdf:about="https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#FavoriteSport">
        <rdfs:comment>An activity favored by a person</rdfs:comment>
        <rdfs:label>Favorite Sport</rdfs:label>
    </owl:Class>
    


    <!-- https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#IndoorSport -->

    <owl:Class rdf:about="https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#IndoorSport">
        <rdfs:subClassOf rdf:resource="https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#FavoriteSport"/>
        <rdfs:comment>An activity happening inside a room</rdfs:comment>
        <rdfs:label>Indoor Sport</rdfs:label>
    </owl:Class>
    


    <!-- https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#Lecturer -->

    <owl:Class rdf:about="https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#Lecturer">
        <rdfs:subClassOf rdf:resource="https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#Person"/>
        <rdfs:comment>A lecturer is a person who gives lectures for a module, especially as an occupation at a university or college of higher education.</rdfs:comment>
        <rdfs:label>Lecturer</rdfs:label>
    </owl:Class>
    


    <!-- https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#OutdoorSport -->

    <owl:Class rdf:about="https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#OutdoorSport">
        <rdfs:subClassOf rdf:resource="https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#FavoriteSport"/>
        <rdfs:comment>An activity outside a room</rdfs:comment>
        <rdfs:label>Outdoor Sport</rdfs:label>
    </owl:Class>
    


    <!-- https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#Person -->

    <owl:Class rdf:about="https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#Person">
        <rdfs:comment>A person is a human being regarded as an individual.</rdfs:comment>
        <rdfs:label>Person</rdfs:label>
    </owl:Class>
    


    <!-- https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#Student -->

    <owl:Class rdf:about="https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#Student">
        <rdfs:subClassOf rdf:resource="https://canvas.utwente.nl/files/folder/users_87153/ontology_practice.owl#Person"/>
        <rdfs:comment>A student is a person who is studying modules at a university or other place of higher education.</rdfs:comment>
        <rdfs:label>Student</rdfs:label>
    </owl:Class>
    


